{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "baseUrl": ".",
    "paths": {
      "webmaxsocket": ["src/index.ts"]
    },
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "example/**/*.ts", "maxclient-bridge.ts"]
}
