{
  "name": "webmaxsocket",
  "version": "1.2.7",
  "description": "Node.js client for Max Messenger: QR, token, SMS auth, 2FA, device sessions (TCP)",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "start": "tsx example/example.ts",
    "example": "tsx example/example.ts",
    "example:token": "tsx example/example-token.ts",
    "example:sms": "tsx example/example-sms.ts",
    "example:sessions-2fa": "tsx example/example-sessions-2fa.ts",
    "example:download": "tsx example/example-download-files.ts",
    "bridge": "tsx maxclient-bridge.ts"
  },
  "keywords": [
    "max",
    "messenger",
    "max-messenger",
    "api",
    "userbot",
    "selfbot",
    "websocket",
    "qr-code",
    "qr-auth",
    "token-auth",
    "bot",
    "nodejs",
    "commonjs",
    "typescript"
  ],
  "author": "Tellarion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tellarion/webmaxsocket.git"
  },
  "bugs": {
    "url": "https://github.com/Tellarion/webmaxsocket/issues"
  },
  "homepage": "https://github.com/Tellarion/webmaxsocket#readme",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "lz4js": "^0.2.0",
    "uuid": "^9.0.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "lz4": "^0.6.5"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.10",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "dist/",
    "src/",
    "example/",
    "maxclient-bridge.ts",
    "README.md",
    "api.package.md"
  ]
}
